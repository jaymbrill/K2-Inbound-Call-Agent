# ElevenLabs — https://elevenlabs.io/app/speech-synthesis/conversational-ai
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_AGENT_ID=agent_...          # filled in after running scripts/setup_agent.py
ELEVENLABS_LLM=claude-3-5-sonnet       # LLM for your agent (gpt-4o also works)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL  # ElevenLabs voice ID (default: Sarah)

# Twilio — https://console.twilio.com
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Server
SERVER_URL=https://your-ngrok-or-domain.com   # public URL Twilio posts to
VALIDATE_TWILIO_SIGNATURE=true                 # set false only for local dev

LOG_LEVEL=INFO
